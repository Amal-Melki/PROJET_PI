<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="689.0" prefWidth="598.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.BlogController">
    <!-- Logo centré en haut -->
    <ImageView fx:id="logo" fitHeight="80.0" fitWidth="80.0" layoutX="259.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="/logo.jpg" /> <!-- Adaptez ce chemin -->
        </image>
    </ImageView>

    <!-- Titre sous le logo -->
    <Label layoutX="186.0" layoutY="110.0" text="Créer un Blog" textFill="#2A5885">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Label>

    <!-- Formulaire principal -->
    <GridPane layoutX="75.0" layoutY="180.0" prefHeight="335.0" prefWidth="448.0" style="-fx-background-color: #F8FAFF; -fx-background-radius: 10; -fx-padding: 20;">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="217.8" minWidth="87.4" prefWidth="87.4" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="362.6" minWidth="362.6" prefWidth="362.6" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="45.6" minHeight="30.8" prefHeight="30.8" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="45.6" minHeight="14.8" prefHeight="14.8" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="125.6" minHeight="120.8" prefHeight="120.8" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="40.6" minHeight="29.4" prefHeight="29.4" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="40.6" minHeight="29.4" prefHeight="29.4" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="84.4" minHeight="77.2" prefHeight="77.2" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="97.0" minHeight="27.6" prefHeight="27.6" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="97.0" minHeight="42.4" prefHeight="42.4" vgrow="SOMETIMES" />
        </rowConstraints>

        <!-- Champs de formulaire avec style bleu -->
        <TextField fx:id="titreField" promptText="Titre" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" GridPane.columnIndex="1" />
        <TextArea fx:id="descriptionField" promptText="Description" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <ComboBox fx:id="categorieComboBox" promptText="Choisir une catégorie" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Button fx:id="uploadImageButton" mnemonicParsing="false" onAction="#UploadImage" text="Choisir une image"
                style="-fx-background-color: #4D90FE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <DatePicker fx:id="dpDate" promptText="xx/mm/yyyy" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <!-- Labels en bleu foncé -->
        <Label text="Titre :" textFill="#2A5885" style="-fx-font-weight: bold;" />
        <Label text="Contenu :" textFill="#2A5885" style="-fx-font-weight: bold;" GridPane.rowIndex="2" />
        <Label text="Catégorie:" textFill="#2A5885" style="-fx-font-weight: bold;" GridPane.rowIndex="4" />
        <Label text="Image :" textFill="#2A5885" style="-fx-font-weight: bold;" GridPane.rowIndex="5" />
        <Label text="Date:" textFill="#2A5885" style="-fx-font-weight: bold;" GridPane.rowIndex="7" />

        <ImageView fx:id="imageView" fitHeight="28.0" fitWidth="124.0" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <!-- Section coordonnées -->
    <GridPane layoutX="75.0" layoutY="530.0" prefHeight="80.0" prefWidth="448.0" style="-fx-background-color: #F8FAFF; -fx-background-radius: 10; -fx-padding: 15;">
        <columnConstraints>
            <ColumnConstraints percentWidth="33" />
            <ColumnConstraints percentWidth="33" />
            <ColumnConstraints percentWidth="34" />
        </columnConstraints>
        <children>
            <TextField fx:id="latitudeField" promptText="Latitude" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" />
            <TextField fx:id="longitudeField" promptText="Longitude" style="-fx-border-color: #4D90FE; -fx-background-radius: 5;" GridPane.columnIndex="1" />
            <Button fx:id="btnVoirLocation" text="Voir Location" onAction="#openMapWindow"
                    style="-fx-background-color: #2A5885; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                    GridPane.columnIndex="2" />
        </children>
    </GridPane>

    <!-- Boutons d'action alignés -->
    <HBox alignment="CENTER" layoutX="75.0" layoutY="630.0" spacing="20" prefHeight="50.0" prefWidth="448.0">
        <Button fx:id="btnDownloadPDF" text="Télécharger PDF" onAction="#handleDownloadPdf"
                style="-fx-background-color: #4D90FE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-min-width: 120;" />
        <Button fx:id="addButton" text="Publier" onAction="#ajouterBlog"
                style="-fx-background-color: #2A5885; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-min-width: 120;" />
        <Button fx:id="btnChoisirIA" text="Assistance IA" onAction="#handleChatGPT"
                style="-fx-background-color: #4D90FE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-min-width: 120;" />
    </HBox>

    <!-- Label position -->
    <Label fx:id="locationLabel" layoutX="200.0" layoutY="690.0" text="Position : N/A" textFill="#4D90FE" style="-fx-font-weight: bold;" />
</AnchorPane>