<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.Admin.ListeProduitDerive"
      spacing="24"
      style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="📦 Inventaire des Articles"
                   style="-fx-text-fill: #2c3e50; -fx-font-size: 28px; -fx-font-weight: bold;"/>

        </HBox>
        <Label text="Gérer et filtrer la liste des produits dérivés."
               style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
    </VBox>

    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Filtrer par Type:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbType" prefWidth="180.0" onAction="#handleFiltrer"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 0 4 0 4;" />
            <Label text="Filtrer par Statut:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbStatut" prefWidth="180.0" onAction="#handleFiltrer"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 0 4 0 4;" />
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="15">
                <TextField fx:id="tfRecherche" promptText="Recherche par nom ou catégories..."
                           prefWidth="220.0" onKeyReleased="#handleFiltrer"
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #e0e0e0; -fx-border-width: 2; -fx-padding: 10 14 10 14;" />
                <Button fx:id="btnAjouter"
                        text="➕ Ajouter Produit"
                        onAction="#handleAjouter"
                        style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6; -fx-font-family: 'Segoe UI Semibold'; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);"/>
            </HBox>
        </HBox>
    </VBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS">
            <Label text="Liste des Produits" style="-fx-text-fill: #2c3e50; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <TableView fx:id="tableProduits"  VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="120.0" text="Nom" />
                <TableColumn fx:id="colCategorie" prefWidth="100.0" text="Catégorie" />
                <TableColumn fx:id="colPrix" prefWidth="80.0" text="Prix" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                <TableColumn fx:id="colImageUrl" prefWidth="170.0" text="Image URL" />
                <TableColumn fx:id="colAction" prefWidth="100" style="-fx-background-color: #f8f9fa; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Action" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <stylesheets>
            <URL value="@/css/table-center.css" />
        </stylesheets>
    </VBox>
</VBox>